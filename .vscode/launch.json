{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "PMS Server",
      "cwd": "${workspaceFolder}/server",
      "program": "${workspaceFolder}/server/src/server.js",
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "PMS Login Page",
      "url": "http://localhost:3000/"
    }
  ],
  "compounds": [
    {
      "name": "PMS (Server + Browser)",
      "configurations": ["PMS Server", "PMS Login Page"],
      "stopAll": true
    }
  ]
}
